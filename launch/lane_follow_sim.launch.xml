<launch>
  <!-- Lane following in simulation.

       camera=true  → run the real lane_detector against a simulated camera
       camera=false → use the synthetic test_lane_publisher (no camera)

       Examples:
         ros2 launch final_challenge lane_follow_sim.launch.xml
         ros2 launch final_challenge lane_follow_sim.launch.xml camera:=true
  -->

  <arg name="camera"           default="false"
       description="Set true to enable the camera-driven lane_detector"/>
  <arg name="cruise_speed_mps" default="4.1"
       description="Forward speed (m/s) — reference racetrack value"/>
  <arg name="drive_topic"      default="/drive"
       description="AckermannDriveStamped topic the simulator subscribes to"/>

  <include if="$(var camera)"
           file="$(find-pkg-share zed_wrapper)/launch/zed_camera.launch.py">
    <arg name="camera_model" value="zed"/>
  </include>

  <node if="$(var camera)"
        pkg="final_challenge" exec="lane_detector" output="screen"/>

  <node unless="$(var camera)"
        pkg="final_challenge" exec="test_lane_publisher" output="screen"/>

  <node pkg="final_challenge" exec="boundary_pure_pursuit" output="screen">
    <param name="drive_topic"      value="$(var drive_topic)"/>
    <param name="cruise_speed_mps" value="$(var cruise_speed_mps)"/>
  </node>

</launch>
