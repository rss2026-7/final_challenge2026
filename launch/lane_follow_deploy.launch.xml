<launch>
  <!-- Real-robot lane following.

       The lane_tracer pure-pursuit defaults live inside lane_follower.py
       (W=0.33 m, D=3.5/4.0/6.0 m tangent/default/corner, v=4.1 m/s).
       The detector's aim-point distance LOOKAHEAD_GROUND_X_M=1.0 m lives
       in lane_detector.py. Only the environment-specific drive topic and
       a couple of high-level toggles are overridden here; everything else
       can be set on the CLI when needed.

       Examples:
         ros2 launch final_challenge lane_follow_deploy.launch.xml
         ros2 launch final_challenge lane_follow_deploy.launch.xml \
              cruise_speed_mps:=2.0 idle_when_blind:=false
  -->

  <arg name="cruise_speed_mps" default="4.1"
       description="Forward speed (m/s)."/>
  <arg name="drive_topic" default="/vesc/high_level/input/nav_0"
       description="AckermannDriveStamped sink. Use the high-level nav_0
                    topic so the safety_controller (subscribed there) can
                    interpose stops / speed limits and publish the final
                    cmd on /vesc/low_level/input/safety. Override to
                    /vesc/low_level/input/navigation only to deliberately
                    bypass safety."/>
  <arg name="idle_when_blind" default="true"
       description="Stop the wheels (v=0) when no fresh boundary path is
                    available — also at startup before the first detection."/>

  <include file="$(find-pkg-share zed_wrapper)/launch/zed_camera.launch.py">
    <arg name="camera_model" value="zed"/>
  </include>

  <node pkg="final_challenge" exec="lane_detector" output="screen"/>

  <node pkg="final_challenge" exec="boundary_pure_pursuit" output="screen">
    <param name="drive_topic"      value="$(var drive_topic)"/>
    <param name="cruise_speed_mps" value="$(var cruise_speed_mps)"/>
    <param name="idle_when_blind"  value="$(var idle_when_blind)"/>
  </node>

</launch>
