<launch>
  <!-- ═══════════════════════════════════════════════════════════════════
       Lane-following on the real robot — Part A: The Great Snail Race
       ═══════════════════════════════════════════════════════════════════

       Key args to set before racing:
         track_side   "left" or "right" — which boundary to hug inward from
         inward_offset  metres inside the chosen boundary (half lane width)

       Run with:
         ros2 launch final_challenge lane_follow_deploy.launch.xml
         ros2 launch final_challenge lane_follow_deploy.launch.xml track_side:=right
  -->

  <arg name="track_side"    default="left"
       description="Which lane boundary to track: left or right"/>
  <arg name="inward_offset" default="0.30"
       description="Metres to drive inside the chosen boundary (≈ half lane width)"/>
  <arg name="nominal_speed" default="2.5"
       description="Target speed on straights (m/s, max 4.0)"/>
  <arg name="drive_topic"   default="/vesc/low_level/input/navigation"
       description="AckermannDriveStamped topic consumed by the VESC"/>

  <!-- ── ZED camera ────────────────────────────────────────────────── -->
  <include file="$(find-pkg-share zed_wrapper)/launch/zed_camera.launch.py">
    <arg name="camera_model" value="zed"/>
  </include>

  <!-- ── Vision: white-line detection + homography → /left_lane_line, /right_lane_line -->
  <node pkg="final_challenge" exec="lane_detector" output="screen"/>

  <!-- ── Control: pure-pursuit on the selected boundary ────────────── -->
  <node pkg="final_challenge" exec="boundary_pure_pursuit" output="screen">
    <param name="drive_topic"         value="$(var drive_topic)"/>
    <param name="track_side"          value="$(var track_side)"/>
    <param name="inward_offset"       value="$(var inward_offset)"/>
    <param name="nominal_speed"       value="$(var nominal_speed)"/>

    <!-- Lookahead distances (metres) -->
    <param name="lookahead_distance"           value="1.2"/>
    <param name="lost_line_lookahead_distance" value="0.9"/>
    <param name="min_lookahead_distance"       value="0.5"/>

    <!-- Speed limits -->
    <param name="lost_line_speed" value="1.0"/>
    <param name="min_speed"       value="0.6"/>
    <param name="max_speed"       value="3.5"/>

    <!-- Curvature adaptation -->
    <param name="curvature_speed_gain"    value="1.2"/>
    <param name="curvature_lookahead_gain" value="2.0"/>

    <!-- Staleness / safety -->
    <param name="stale_path_timeout"  value="0.75"/>
    <param name="fresh_msg_timeout"   value="0.2"/>
    <param name="min_path_arc_length" value="0.3"/>
    <param name="stop_if_no_path"     value="true"/>

    <!-- Steering smoothing (0=none, 1=instant) -->
    <param name="steering_alpha"      value="0.35"/>
    <param name="max_steering_angle"  value="0.40"/>
  </node>

</launch>
