<launch>
  <!-- ═══════════════════════════════════════════════════════════════════
       Lane-following on the real robot — Part A: The Great Snail Race

       Run with:
         ros2 launch final_challenge lane_follow_deploy.launch.xml

       Controller is BoundaryPurePursuit (lane_follower.py):
         midline = parabola fit through L/R lane samples → cross-track at
         e_y_eval_x → P + arc-FF (gated on full bilateral coverage) →
         EMA + slew + saturate.
       Source defaults are the live-robot values; this launch file only
       overrides what's strictly environment-specific (the VESC topic).
       Other params can be overridden on the CLI:
         ros2 launch final_challenge lane_follow_deploy.launch.xml \
              nominal_speed:=1.5 stop_if_no_path:=false
       ═══════════════════════════════════════════════════════════════════ -->

  <!-- ── CLI-overridable args ──────────────────────────────────────── -->
  <arg name="nominal_speed" default="2.0"
       description="Target speed (m/s). 2.0 was chosen after run-20260503-060123
                    showed catch-up distance at 3.5 m/s was 4.8× the lane
                    half-width (structural under-damping). Raise once the
                    controller's tracking is verified clean at this speed."/>
  <arg name="drive_topic" default="/vesc/low_level/input/navigation"
       description="AckermannDriveStamped topic consumed by the VESC."/>
  <arg name="stop_if_no_path" default="true"
       description="If true, publish 0 m/s when no fresh path is available
                    (also at startup before first BILATERAL fix). Prevents
                    the start-of-run blind-drive that put the car one lane
                    over in run-20260503-050721. Set false for graceful
                    degradation during brief perception dropouts."/>

  <!-- ── ZED camera ────────────────────────────────────────────────── -->
  <include file="$(find-pkg-share zed_wrapper)/launch/zed_camera.launch.py">
    <arg name="camera_model" value="zed"/>
  </include>

  <!-- ── Vision: white-line detection + homography ────────────────── -->
  <node pkg="final_challenge" exec="lane_detector" output="screen"/>

  <!-- ── Control: parabola-fit lane follower ──────────────────────── -->
  <!-- All other params (kp_lat=0.30, kd_lat=0.0, half_lane_width=0.425,
       width_tol=0.20, camera_y_offset=-0.065, e_y_eval_x=1.5, etc.) are
       declared with their measured/tuned defaults inside lane_follower.py.
       Only environment-specific overrides are needed here. -->
  <node pkg="final_challenge" exec="boundary_pure_pursuit" output="screen">
    <param name="drive_topic"      value="$(var drive_topic)"/>
    <param name="nominal_speed"    value="$(var nominal_speed)"/>
    <param name="stop_if_no_path"  value="$(var stop_if_no_path)"/>
  </node>

</launch>
